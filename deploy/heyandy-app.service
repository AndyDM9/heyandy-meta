[Unit]
Description=HeyAndy: Andy on the Reachy Mini (voice, finding, reminders); nothing said is logged
After=jarvis-daemon.service heyandy-glimmer.service heyandy-sam.service heyandy-voice.service heyandy-guard.service heyandy-depth.service
# The robot's own driver (motors, camera, microphone) starts with Andy, not by itself at boot.
Wants=jarvis-daemon.service heyandy-glimmer.service heyandy-sam.service heyandy-voice.service heyandy-guard.service heyandy-depth.service

[Service]
WorkingDirectory=%h/Documents/GitHub/heyandy-meta
Environment=PYTHONPATH=%h/Documents/GitHub/heyandy-meta
Environment=PYTHONWARNINGS=ignore
# Everything Andy loads from Hugging Face (Pollen's recorded emotions) is already here: never wait on the network for
# it, so pulling the cable on camera can't stall a turn.
Environment=HF_HUB_OFFLINE=1
# The Model API key, kept out of the repository: a file only its owner can read, with lines
#   MODEL_API_KEY=...
#   HEYANDY_PAID_CALLS=1
# (chmod 600). Without it, Andy runs entirely on this computer.
EnvironmentFile=-%h/.config/heyandy-meta/env
# The robot's camera arrives over WebRTC: GStreamer's webrtc element is a local build (gst-plugins-rs), found
# only through this path. Without it the robot's media can't start (it happened after the Oct 30 restart).
Environment=GST_PLUGIN_PATH=%h/.local/gst-plugins-rs/lib/x86_64-linux-gnu/gstreamer-1.0
# At boot, wait (up to 2 minutes) for the robot's driver to say it's ready, not just for its process to start.
ExecStartPre=/bin/sh -c 'for i in $(seq 120); do curl -sf -m 2 http://127.0.0.1:8000/api/daemon/status | grep -q ready.:true && exit 0; sleep 1; done; exit 1'
TimeoutStartSec=150
ExecStart=%h/Documents/GitHub/heyandy-meta/.venv/bin/python -u -m heyandy_meta --robot --voice --quiet
StandardInput=null
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
