[Unit]
Description=HeyAndy: hearing (Omnilingual ASR) and speaking (MMS-TTS), Meta's, on GPU 1 (this computer only)

[Service]
# Every model Andy runs is Meta's. The voice is MMS-TTS with the clarity processing the founder picked by ear on the
# robot's speaker (Oct 30); SeamlessM4T v2 is there too (--voice-model seamless; it would need about 3.3 GB on GPU 0).
Environment=CUDA_DEVICE_ORDER=PCI_BUS_ID
Environment=CUDA_VISIBLE_DEVICES=1,0
Environment=PYTHONWARNINGS=ignore
Environment=HF_HUB_OFFLINE=1
ExecStart=%h/opt/voice/.venv/bin/python %h/Documents/GitHub/heyandy-meta/local/voice_server.py --voice-model mms
Restart=on-failure

[Install]
WantedBy=default.target
